{
  "name": "control-de-comportamiento",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "types:local": "supabase gen types typescript --local --schema public > src/types/supabase.ts",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.js",
    "db:start:local": "supabase start",
    "db:reset:local": "supabase db reset --no-seed && npm run types:local",
    "db:seed:local": "supabase db query --local --file supabase/seed/seed.sql",
    "db:migrate:production": "supabase migration up --linked"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/postcss": "^4.3.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3"
  }
}
